# Moonshot / Kimi API (Agent orchestration)
MOONSHOT_API_KEY=sk-your-key-here
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2.6
# kimi-k2.6 fixes temperature by thinking mode (enabled→1.0, disabled→0.6); client sets this
MOONSHOT_TEMPERATURE=1
# disabled = lower TTFT (default); enabled = deep reasoning (slower first token)
MOONSHOT_THINKING=disabled
# Comma-separated models that always use fixed temperature + thinking switch
# MOONSHOT_FIXED_TEMPERATURE_MODELS=kimi-k2.6
# Optional alias: KIMI_API_KEY
KIMI_TIMEOUT_SECONDS=60
KIMI_MAX_CONCURRENCY=8
AGENT_TIMEOUT_SECONDS=120

# Hugging Face Hub (optional — for gated models / higher rate limits)
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Local Qwen model (RAG generation)
QWEN_MODEL_PATH=Qwen/Qwen3.5-2B
LORA_PATH=./models/qwen35_2b_lora
# local = in-process / remote Qwen; cloud = Kimi for RAG answers
# docker-compose overrides api service to cloud by default
RAG_BACKEND=local
MAX_NEW_TOKENS=256

# RAG settings
RAG_TOP_K=3
CHUNK_SIZE=128
KNOWLEDGE_DIR=./data/knowledge
CHROMA_PERSIST_DIR=./data/chroma
RETRIEVER_TYPE=hybrid
EMBEDDING_MODEL=BAAI/bge-m3
HYBRID_RRF_K=60
# Vector similarity reject floor (hybrid/vector); empty retrieval → suggest human
RAG_MIN_SCORE=0.60
# After RRF, allow at most N chunks from the same source file
RAG_MAX_PER_SOURCE=2
AGENT_MAX_STEPS=4

# JWT auth (browser Web UI)
# 必填：生产环境禁止使用默认值（启动时会校验）
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_COOKIE_NAME=kefu_token
OAUTH_GOOGLE_CLIENT_ID=

# Database
DATABASE_URL=postgresql+asyncpg://kefu:kefu@localhost:5432/kefu
REDIS_URL=redis://localhost:6379/0

# Environment
ENV=development
# Behind nginx / reverse proxy — use client IP from X-Forwarded-For
TRUSTED_PROXY=false

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=change-me-in-production
# Set ENV=production in production; API_KEY is required and must not be default
QWEN_INFERENCE_URL=
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
METRICS_REQUIRE_AUTH=true
MAX_UPLOAD_BYTES=1048576

# Session
SESSION_MAX_HISTORY=6
SESSION_REDIS_TTL=86400

# Logistics API (optional - uses mock if empty)
LOGISTICS_API_URL=
LOGISTICS_API_KEY=

# Order API (optional)
ORDER_API_URL=
ORDER_API_KEY=

# Complaint webhook (optional)
COMPLAINT_WEBHOOK_URL=

# API key rotation grace period (optional previous key)
API_KEY_PREVIOUS=

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=zhineng-kefu
OTEL_EXPORTER_OTLP_ENDPOINT=

# Logging
LOG_LEVEL=INFO
